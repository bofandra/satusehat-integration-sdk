{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SATUSEHAT Integration Event",
  "type": "object",
  "required": [
    "event_id",
    "organization_id",
    "operation",
    "resource_type",
    "status",
    "attempt",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "organization_id": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "operation": {
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH"
      ]
    },
    "resource_type": {
      "type": "string",
      "minLength": 1
    },
    "resource_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": [
        "object",
        "array",
        "null"
      ]
    },
    "status": {
      "enum": [
        "QUEUED",
        "PROCESSING",
        "SUCCESS",
        "WAITING_FOR_CORRECTION",
        "RATE_LIMITED",
        "RETRYING",
        "DEAD_LETTER",
        "CANCELLED"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "http_status": {
      "type": [
        "integer",
        "null"
      ]
    },
    "error_category": {
      "type": [
        "string",
        "null"
      ]
    },
    "error_message": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "next_retry_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent_event_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "source_system": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_record_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "disposition": {
      "type": [
        "string",
        "null"
      ]
    },
    "error_details": {
      "type": [
        "object",
        "null"
      ]
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "superseded_by_event_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
