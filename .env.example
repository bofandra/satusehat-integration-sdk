SATUSEHAT_ENV=sandbox
SATUSEHAT_CLIENT_ID=
SATUSEHAT_CLIENT_SECRET=
SATUSEHAT_ORGANIZATION_ID=
SATUSEHAT_QUEUE_PATH=./satusehat-sdk.db
SATUSEHAT_TIMEOUT_SECONDS=30
SATUSEHAT_RATE_LIMIT_RPM=300
SATUSEHAT_MAX_RETRIES=5
SATUSEHAT_PROCESSING_TIMEOUT_SECONDS=300
SATUSEHAT_INITIAL_BACKOFF_MS=1000
SATUSEHAT_MAX_BACKOFF_MS=60000
# Optional overrides:
# SATUSEHAT_OAUTH_BASE_URL=
# SATUSEHAT_FHIR_BASE_URL=
# SATUSEHAT_SANDBOX_ENABLE_WRITES=false
# SATUSEHAT_SANDBOX_WRITE_FIXTURE=examples/fhir/encounter.json

# Integration Console / dashboard (v0.2)
SATUSEHAT_CONSOLE_HOST=127.0.0.1
SATUSEHAT_CONSOLE_PORT=8787
SATUSEHAT_CONSOLE_API_TOKEN=
SATUSEHAT_WEBHOOK_URL=
SATUSEHAT_WEBHOOK_SECRET=
SATUSEHAT_WEBHOOK_EVENTS=correction_required,dead_letter
SATUSEHAT_WEBHOOK_TIMEOUT_SECONDS=10
SATUSEHAT_WEBHOOK_MAX_RETRIES=8
