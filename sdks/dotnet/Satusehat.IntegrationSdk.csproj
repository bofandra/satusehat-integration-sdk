<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Satusehat.IntegrationSdk</PackageId>
    <Version>0.1.0</Version>
    <Authors>SATUSEHAT Integration SDK Contributors</Authors>
    <Description>SATUSEHAT Integration SDK reference implementation for .NET.</Description>
    <PackageTags>satusehat;fhir;healthcare;integration;sdk</PackageTags>
    <PackageReleaseNotes>Official production-ready reference SDK v0.1.0.</PackageReleaseNotes>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/satusehat-platform/integration-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/satusehat-platform/integration-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="examples/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.23" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
